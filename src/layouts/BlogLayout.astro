---
import Section from "../components/Section.astro";
import Layout from "./Layout.astro";
import { renderInlineMarkdown, toPlainText } from "../lib/markdown";

const { frontmatter } = Astro.props;

const titleHtml = await renderInlineMarkdown(frontmatter.title);
const descriptionHtml = await renderInlineMarkdown(frontmatter.description);
---

<Layout>
  <Fragment slot="head">
    <meta property="og:title" content={toPlainText(frontmatter.title)} />
    <meta
      property="og:description"
      content={toPlainText(frontmatter.description)}
    />
    {frontmatter.image && (
      <meta property="og:image" content={frontmatter.image} />
    )}
  </Fragment>

  <article>
    <Section>
      <h1 class="text-4xl sm:text-4xl" set:html={titleHtml} />
      <p class="mt-3 text-neutral-300 italic">
        <Fragment set:html={descriptionHtml} /> &middot;{" "}
        {frontmatter.minutesRead}
      </p>
    </Section>
    <Section class="prose max-w-none prose-invert [--tw-prose-invert-body:var(--color-white)] prose-headings:font-display prose-headings:font-normal prose-headings:my-5 prose-p:my-5 prose-a:text-accent py-0!">
      <slot />
    </Section>
  </article>
</Layout>

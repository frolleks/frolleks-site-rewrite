---
import Card from "../components/Card.astro";
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
---

<Layout>
  <Fragment slot="head">
    <meta property="og:title" content={frontmatter.title} />
    <meta property="og:description" content={frontmatter.description} />
    {frontmatter.image && (
      <meta property="og:image" content={frontmatter.image} />
    )}
  </Fragment>

  <div class="flex h-full min-h-0 flex-col gap-y-4">
    <Card class="shrink-0 flex flex-col gap-y-1">
      <h1 class="text-5xl">{frontmatter.title}</h1>
      <p class="italic text-neutral-300">
        {frontmatter.description} &middot; {frontmatter.minutesRead}
      </p>
    </Card>
    <Card class="flex min-h-0 flex-1 flex-col mb-4">
      <article class="min-h-0 prose prose-invert max-w-none prose-headings:font-display prose-headings:font-normal prose-a:text-[rgba(180,206,77,1)]">
        <slot />
      </article>
    </Card>
  </div>
</Layout>

---
import Section from "../components/Section.astro";
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
---

<Layout>
  <Fragment slot="head">
    <meta property="og:title" content={frontmatter.title} />
    <meta property="og:description" content={frontmatter.description} />
    {frontmatter.image && (
      <meta property="og:image" content={frontmatter.image} />
    )}
  </Fragment>

  <article>
    <Section>
      <h1 class="text-4xl sm:text-5xl">{frontmatter.title}</h1>
      <p class="mt-3 text-neutral-300 italic">
        {frontmatter.description} &middot; {frontmatter.minutesRead}
      </p>
    </Section>
    <Section class="prose max-w-none prose-invert prose-headings:font-display prose-headings:font-normal prose-a:text-accent">
      <slot />
    </Section>
  </article>
</Layout>

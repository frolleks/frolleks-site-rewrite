---
import "../styles/global.css";
import bgImage from "../assets/background.png";
import Navbar from "../components/Navbar.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>frolleks</title>
    <slot name="head" />
  </head>

  <body>
    <div
      class="fixed inset-0 -z-10 w-full h-screen bg-cover bg-center bg-no-repeat"
      style={`background-image: url(${bgImage.src});`}
    ></div>
    <div class="relative">
      <div class="relative z-10 container mx-auto flex h-full max-w-2xl flex-col lg:max-w-4xl">
        <div class="shrink-0">
          <Navbar />
        </div>

        <main>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

---
interface Props {
  title?: string;
  /** Heading level for the title: 1 on pages whose only heading it is. */
  level?: 1 | 2;
  class?: string;
}

const { title, level = 2, class: className } = Astro.props;
---

<section class:list={["border-t border-accent/30 py-8", className]}>
  {title && (
    <p class="mb-2 w-fit bg-accent px-2 font-bold text-black">{title}</p>
  )}
  <slot />
</section>

---
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import ContactInfo from "../components/ContactInfo.astro";
import LinkRow from "../components/LinkRow.astro";
import Section from "../components/Section.astro";

import pfp from "../assets/pfp.jpg";

const socials = [
  { icon: "mdi:twitter", label: "@frolleks" },
  { icon: "ic:baseline-discord", label: "@frolleks" },
  { icon: "mdi:email", label: "hello@frolleks.site" },
];

const links = [
  {
    href: "https://github.com/frolleks",
    title: "my github",
    description: "i put all of my projects there, check it out",
  },
  {
    href: "/blog",
    title: "blog",
    description: "when twitter is not enough for my yappings",
  },
  {
    href: "https://github.com/frolleks/frolleks-site-rewrite",
    title: "source code",
    description: "this site's code is fully open source, check it out too",
  },
];
---

<Layout>
  <Section>
    <div class="flex items-start justify-between gap-x-8">
      <div>
        <h1 class="text-4xl sm:text-5xl">hi, i'm frolleks</h1>
        <p class="mt-4">
          i play video games, code, and read books sometimes. i'm currently more
          into classics, hit me up if you got any recommendations.
        </p>
      </div>

      <figure class="hidden shrink-0 sm:block">
        <Image
          src={pfp}
          alt="frolleks' profile picture"
          width={384}
          height={384}
          class="w-48 border border-accent/60"
        />
        <figcaption class="mt-1 text-sm text-neutral-400 italic">
          {"<3"} mitsuki!
        </figcaption>
      </figure>
    </div>
  </Section>

  <Section title="contact me">
    <div class="mt-4 flex flex-wrap gap-2">
      {socials.map((social) => (
        <ContactInfo icon={social.icon} label={social.label} />
      ))}
    </div>
  </Section>

  <Section title="links">
    <ul class="divide-y divide-accent/20">
      {links.map((link) => (
        <LinkRow href={link.href} title={link.title}>
          <p>{link.description}</p>
        </LinkRow>
      ))}
    </ul>
  </Section>
</Layout>

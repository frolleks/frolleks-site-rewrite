---
import LinkRow from "../../components/LinkRow.astro";
import Section from "../../components/Section.astro";
import Layout from "../../layouts/Layout.astro";

const projects = [
  {
    href: "https://soter.frolleks.site",
    title: "Soter",
    description:
      "A Discord moderation bot that removes hate speech and spam, and times out repeat offenders.",
  },
  {
    href: "https://github.com/frolleks/nutmeg",
    title: "nutmeg",
    description: "Run macOS Roblox on Linux.",
  },
];
---

<Layout>
  <Section title="projects" level={1}>
    <ul class="divide-y divide-accent/20">
      {projects.map((project) => (
        <LinkRow href={project.href} title={project.title}>
          <p>{project.description}</p>
        </LinkRow>
      ))}
    </ul>
  </Section>
</Layout>
